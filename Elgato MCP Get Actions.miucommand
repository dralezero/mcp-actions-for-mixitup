{"$type":"MixItUp.Base.Model.Commands.ActionGroupCommandModel, MixItUp.Base","RunOneRandomly":false,"ID":"b1d44386-376f-4328-b1b9-6939838dc642","Name":"Elgato MCP Get Actions","Type":4,"IsEnabled":true,"Unlocked":false,"IsEmbedded":false,"GroupName":"Elgato MCP","Triggers":[],"Requirements":{"$type":"MixItUp.Base.Model.Requirements.RequirementsSetModel, MixItUp.Base","Requirements":[]},"Actions":[{"$type":"MixItUp.Base.Model.Actions.WebRequestActionModel, MixItUp.Base","Url":"http://localhost:9090/mcp","ResponseType":0,"JSONToSpecialIdentifiers":null,"HttpMethod":1,"CustomHeaders":{"$type":"System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib","Accept":"application/json, text/event-stream","Content-Type":"application/json","mcp-session-id":"$elgatomcpsessionid"},"RequestBody":"{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"streamdeck__get_executable_actions\",\"arguments\":{}},\"id\":3}","ID":"8b0c43b7-1bc4-4e6e-8963-2a3fee5a037f","Name":"Web Request","Type":11,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpfilepath\\mcpactions_json.txt","TransferText":"$webrequestresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"6cbfe210-8868-4ab9-89fc-f7760afba796","Name":"File (Read & Write)","Type":13,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//vibecoded by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n    \t{\r\n            string raw = System.IO.File.ReadAllText(@\"$elgatomcpfilepath\\mcpactions_json.txt\");\r\n            raw = raw.Replace(\"\\\\n\", \"\").Replace(\"\\\\\\\"\", \"\\\"\");\r\n\r\n            string result = \"\";\r\n            int pos = 0;\r\n\r\n            while (pos < raw.Length)\r\n            {\r\n                // Find title first\r\n                int titleIndex = raw.IndexOf(\"\\\"title\\\": \\\"\", pos);\r\n                if (titleIndex < 0) break;\r\n                int titleStart = titleIndex + 10;\r\n                int titleEnd = raw.IndexOf(\"\\\"\", titleStart);\r\n                if (titleEnd < 0) break;\r\n                string title = raw.Substring(titleStart, titleEnd - titleStart);\r\n                title = title.Trim().ToUpper();\r\n\r\n                // Search BACKWARDS before title for the UUID id\r\n                string id = \"\";\r\n                int searchBack = titleIndex;\r\n                while (searchBack > pos)\r\n                {\r\n                    int idIndex = raw.LastIndexOf(\"\\\"id\\\": \\\"\", searchBack);\r\n                    if (idIndex < pos) break;\r\n                    int idStart = idIndex + 7;\r\n                    if (idStart + 36 > raw.Length) break;\r\n                    string candidate = raw.Substring(idStart, 36);\r\n                    if (candidate[8] == '-' && candidate[13] == '-' && candidate[18] == '-' && candidate[23] == '-')\r\n                    {\r\n                        id = candidate;\r\n                        break;\r\n                    }\r\n                    searchBack = idIndex - 1;\r\n                }\r\n\r\n                if (id != \"\")\r\n                    result += title + \":\" + id + \"\\n\";\r\n\r\n                pos = titleEnd;\r\n            }\r\n\r\n            return result == \"\" ? \"NO RESULTS\" : result;\r\n            \r\n            }\r\n   \t\t\t catch (Exception ex)\r\n    \t\t{\r\n      \t\t  return \"ERROR: \" + ex.Message;\r\n    \t\t}\r\n            \r\n            \r\n        }\r\n    }\r\n}","ID":"3a10cee1-1eef-49df-91e6-e86218f5ec3b","Name":"Script","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpfilepath\\mcpactions_list.txt","TransferText":"$scriptresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"2521e0ed-ce9b-4b3e-84f2-eb5382a7fa8c","Name":"File (Read & Write)","Type":13,"Enabled":true}]}