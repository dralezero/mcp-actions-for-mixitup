":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$allargs","Value2":"","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$allargs","Value2":"@$username","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n        {\r\n            string search = \"$allargs\";\r\n            search = search.Trim().ToUpper();\r\n            string[] lines = System.IO.File.ReadAllLines(@\"$elgatomcpfilepath\\mcpactions_list.txt\");\r\n\r\n            foreach (string line in lines)\r\n            {\r\n                int colonIndex = line.IndexOf(\":\");\r\n                if (colonIndex < 0) continue;\r\n\r\n                string key = line.Substring(0, colonIndex).Trim();\r\n                string value = line.Substring(colonIndex + 1).Trim();\r\n\r\n                if (key == search)\r\n                {\r\n                    return value;\r\n                }\r\n            }\r\n\r\n            return \"ERROR: MCP Action \\\"$allargs\\\" not found in list.\";\r\n            \r\n            }\r\n            catch (Exception ex)\r\n\t\t\t{\r\n\t\t\t\tstring message = ex.Message.Replace(@\"$elgatomcpfilepath\\\", \"\");\r\n                return \"ERROR: \" + message;\r\n\t\t\t}\r\n            \r\n        }\r\n    }\r\n}","ID":"a1fbd57e-d672-472b-92fd-61ef4c0b45e7","Name":"Get MCP Action ID from file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcplistlookupresult1","ReplacementText":"$scriptresult","MakeGloballyUsable":false,"ShouldProcessMath":false,"Repla