fb50-6aeb-4c8a-9d31-740e6dd4922f","Name":"Start MCP Server","Type":3,"Enabled":true}],"ID":"1505cd24-18ae-4e10-931b-ab19ab02f312","Name":"Restart MCP Server","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"C:\\Windows\\System32\\curl.exe","Arguments":"-s -g -X POST -H \"Accept: application/json, text/event-stream\" -H \"Content-Type: application/json\" -d \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\\"initialize\\\",\\\"params\\\":{\\\"protocolVersion\\\":\\\"2024-11-05\\\",\\\"capabilities\\\":{},\\\"clientInfo\\\":{\\\"name\\\":\\\"test\\\",\\\"version\\\":\\\"1.0\\\"}},\\\"id\\\":1}\" -D - -o nul http://$elgatomcpurl/mcp","ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":true,"ID":"f9aefaa3-e1b1-4194-9ca5-08d2a8776826","Name":"Get MCP Server Info","Type":3,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string headers = @\"$externalprogramresult\";\r\n\r\n                string sessionId = null;\r\n                foreach (string line in headers.Split('\\n'))\r\n                {\r\n                    if (line.StartsWith(\"mcp-session-id:\"))\r\n                    {\r\n                        sessionId = line.Split(':')[1].Trim();\r\n                        break;\r\n                    }\r\n                }\r\n\r\n                return sessionId;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                return ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"38551259-d119-4007-8013-c6ac177d6d9f","Name":"Extract MCP Session ID","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpsessionid","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"5299e391-a958-4fe3-a51d-8416eb1d160b","Name":"Save Session ID to Special Identifier","Type":12,"Enabled":true}],"ID":"5f66a17d-37fd-438d-a973-607f8f4c2202","Name":"Get MCP Session ID","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.WebRequestActionModel, MixItUp.Base","Url":"http://$elgatomcpurl/mcp","ResponseType":0,"JSONToSpecialIdentifiers":null,"HttpMethod":1,"CustomHeaders":{"$type":"System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib","Accept":"application/json, text/event-stream","Content-Type":"application/json","mcp-session-id":"$elgatomcpsessionid"},"RequestBody":"{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"streamdeck__get_executable_actions\",\"arguments\":{}},\"id\":3}","ID":"48934904-c6f7-44d4-83d4-fc2f356d15f1","Name":"Get MCP Actions data","Type":11,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpfilepath\\mcpactions_json.txt","TransferText":"$webrequestresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"8f737a3c-5150-4d75-a480-f9761626fbb2","Name":"Save MCP Actions data to file","Type":13,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero using Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n    \t{\r\n            string raw = System.IO.File.ReadAllText(@\"$elgatomcpfilepath\\mcpactions_json.txt\");\r\n            raw = raw.Replace(\"\\\\n\", \"\").Replace(\"\\\\\\\"\", \"\\\"\");\r\n\r\n            string result = \"\";\r\n            int pos = 0;\r\n\r\n            while (pos < raw.Length)\r\n            {\r\n                // Find title first\r\n                int titleIndex = raw.IndexOf(\"\\\"title\\\": \\\"\", pos);\r\n                if (titleIndex < 0) break;\r\n                int titleStart = titleIndex + 10;\r\n                int titleEnd = raw.IndexOf(\"\\\"\", titleStart);\r\n                if (titleEnd < 0) break;\r\n                string title = raw.Substring(titleStart, titleEnd - titleStart);\r\n                title = title.Trim().ToUpper();\r\n\r\n                // Search BACKWARDS before title for the UUID id\r\n                string id = \"\";\r\n                int searchBack = titleIndex;\r\n                while (searchBack > pos)\r\n                {\r\n                    int idIndex = raw.LastIndexOf(\"\\\"id\\\": \\\"\", searchBack);\r\n                    if (idIndex < pos) break;\r\n                    int idStart = idIndex + 7;\r\n                    if (idStart + 36 > raw.Length) break;\r\n                    string candidate = raw.Substring(idStart, 36);\r\n                    if (candidate[8] == '-' && candidate[13] == '-' && candidate[18] == '-' && candidate[23] == '-')\r\n                    {\r\n                        id = candidate;\r\n                        break;\r\n                    }\r\n                    searchBack = idIndex - 1;\r\n                }\r\n\r\n                if (id != \"\")\r\n                    result += title + \":\" + id + \"\\n\";\r\n\r\n                pos = titleEnd;\r\n            }\r\n\r\n            return result == \"\" ? \"NO RESULTS\" : result;\r\n            \r\n            }\r\n   \t\t\t catch (Exception ex)\r\n    \t\t{\r\n      \t\t  return \"ERROR: \" + ex.Message;\r\n    \t\t}\r\n            \r\n            \r\n        }\r\n    }\r\n}","ID":"84914914-3fe5-4a88-9be9-303478885020","Name":"Parse MCP Actions data from file","Type":38,"Enabled":false},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero using Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n\t\t\r\n            try\r\n            {\r\n                string raw = System.IO.File.ReadAllText(@\"$elgatomcpfilepath\\mcpactions_json.txt\");\r\n                raw = raw.Replace(\"\\\\n\", \"\").Replace(\"\\\\\\\"\", \"\\\"\");\r\n\t\t\t\t\r\n                string result = \"\";\r\n                int pos = 0;\r\n\t\t\t\t\r\n                while (pos < raw.Length)\r\n                {\r\n                    // Find title first\r\n                    int titleIndex = raw.IndexOf(\"\\\"title\\\": \\\"\", pos);\r\n                    if (titleIndex < 0) break;\r\n                    int titleStart = titleIndex + 10;\r\n                    int titleEnd = raw.IndexOf(\"\\\"\", titleStart);\r\n                    if (titleEnd < 0) break;\r\n                    string title = raw.Substring(titleStart, titleEnd - titleStart);\r\n                    title = title.Trim().ToUpper();\r\n\t\t\t\t\t\r\n                    // Search BACKWARDS before title for the UUID id\r\n                    string id = \"\";\r\n                    int searchBack = titleIndex;\r\n                    while (searchBack > pos)\r\n                    {\r\n                        int idIndex = raw.LastIndexOf(\"\\\"id\\\": \\\"\", searchBack);\r\n                        if (idIndex < pos) break;\r\n                        int idStart = idIndex + 7;\r\n                        if (idStart + 36 > raw.Length) break;\r\n                        string candidate = raw.Substring(idStart, 36);\r\n                        if (candidate[8] == '-' && candidate[13] == '-' && candidate[18] == '-' && candidate[23] == '-')\r\n                        {\r\n                            id = candidate;\r\n                            break;\r\n                        }\r\n                        searchBack = idIndex - 1;\r\n                    }\r\n                    if (id != \"\")\r\n                        result += (result == \"\" ? \"{\" : \",\") + \"\\\\\\\"\" + title + \"\\\\\\\":\\\\\\\"\" + id + \"\\\\\\\"\";\r\n                    pos = titleEnd;\r\n                }\r\n                return result == \"\" ? \"NO RESULTS\" : result + \"}\";\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                return \"ERROR: \" + ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"21fed484-3ce1-4708-ad26-6c94795f0492","Name":"Parse MCP Actions data from file - store in JSON","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpactionslist","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"f031f800-db62-43b9-b006-8228e231a24c","Name":"Save MCP Actions list to Special Identifer","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpfilepath\\mcpactions_list.txt","TransferText":"$scriptresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"4062aae5-fc1d-4526-a089-08b0dec51ab8","Name":"Save MCP Actions list to file","Type":13,"Enabled":false}],"ID":"c78fd261-9ae5-4feb-a477-d79b515fd79e","Name":"Refresh Available MCP Actions","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcperrorschat","Value2":"on","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ChatActionModel, MixItUp.Base","ChatText":"Elgato MCP Server Restarting","SendAsStreamer":false,"IsWhisper":false,"WhisperUserName":null,"ID":"73cb0cf3-0cbd-4f9e-a15b-224710ae6a02","Name":"Chat Message","Type":1,"Enabled":true}],"ID":"fd784762-351c-4ba4-80a8-9e42933f7528","Name":"Message to chat: server restarting","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcprestarted","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"8cce569a-e102-43ef-a0ca-6dc1442db348","Name":"MCP Server Restarted: TRUE","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":1,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcprestartrequested","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$$elgatomcpactionissue","Value2":"true","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[],"ID":"6829b9cf-9511-4823-b710-ee2ba8612048","Name":"If issues or restart request, restart","Type":17,"Enabled":true}],"ID":"71396103-3f64-45ee-8d22-96a8630be4b5","Name":"Restart MCP server if issue or requested","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcpactionissue","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcprestarted","Value2":"true","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n        {\r\n            string search = \"$allargs\";\r\n            search = search.Trim().ToUpper();\r\n            string[] lines = System.IO.File.ReadAllLines(@\"$elgatomcpfilepath\\mcpactions_list.txt\");\r\n\r\n            foreach (string line in lines)\r\n            {\r\n                int colonIndex = line.IndexOf(\":\");\r\n                if (colonIndex < 0) continue;\r\n\r\n                string key = line.Substring(0, colonIndex).Trim();\r\n                string value = line.Substring(colonIndex + 1).Trim();\r\n\r\n                if (key == search)\r\n                {\r\n                    return value;\r\n                }\r\n            }\r\n\r\n            return \"ERROR: MCP Action \\\"$allargs\\\" not found in list.\";\r\n            \r\n            }\r\n            catch (Exception ex)\r\n\t\t\t{\r\n\t\t\t\tstring message = ex.Message.Replace(@\"$elgatomcpfilepath\\\", \"\");\r\n                return \"ERROR: \" + message;\r\n\t\t\t}\r\n            \r\n        }\r\n    }\r\n}","ID":"0af21eb6-f093-4c1a-8569-78478e03a619","Name":"Get MCP Action ID from file","Type":38,"Enabled":false},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string json = \"$elgatomcpactionslist\";\r\n\r\n                string searchKey = \"$allargs\".Trim().ToUpper();\r\n                string key = \"\\\"\" + searchKey + \"\\\":\\\"\";\r\n                int keyIndex = json.IndexOf(key);\r\n\r\n                if (keyIndex == -1)\r\n                    return \"ERROR: MCP Action \\\"$allargs\\\" not found in list\";\r\n\r\n                int valueStart = keyIndex + key.Length;\r\n                int valueEnd = json.IndexOf('\"', valueStart);\r\n\r\n                if (valueEnd == -1)\r\n                    return \"ERROR: MCP Action list may be corrupt\";\r\n\r\n                return json.Substring(valueStart, valueEnd - valueStart);\r\n            }\r\n            catch\r\n            {\r\n                return \"ERROR: Unexpected error reading MCP Action list from Special Identifier\";\r\n            }\r\n        }\r\n    }\r\n}","ID":"3b66e151-fb08-4063-bf4d-a43c7711e0bd","Name":"Get MCP Action ID from Special Identifier","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcplistlookupresult2","ReplacementText":"$scriptresult","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"2b342068-ddde-4864-aa3b-b0d27cc6d408","Name":"Store script result","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":6,"Value1":"$elgatomcplistlookupresult2","Value2":"ERROR","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcperroractionslist2","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"76416541-c606-48bb-99df-f0c3a741322b","Name":"Error","Type":12,"Enabled":true}],"ID":"e7d720a7-cab1-48aa-ac80-c095d131ca6a","Name":"If Action not found, error","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","Ca