\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string json = \"$elgatomcpactionslist\";\r\n                \r\n                if (string.IsNullOrEmpty(json))\r\n                    return \"ERROR: MCP Action list is empty or not set\";\r\n\r\n                string searchKey = \"$allargs\".Trim().ToUpper();\r\n                string key = \"\\\"\" + searchKey + \"\\\":\\\"\";\r\n                int keyIndex = json.IndexOf(key);\r\n\r\n                if (keyIndex == -1)\r\n                    return \"ERROR: MCP Action \\\"$allargs\\\" not found in list stored in MIU.\";\r\n\r\n                int valueStart = keyIndex + key.Length;\r\n                int valueEnd = json.IndexOf('\"', valueStart);\r\n\r\n                if (valueEnd == -1)\r\n                    return \"ERROR: MCP Action list may be corrupt\";\r\n\r\n                return json.Substring(valueStart, valueEnd - valueStart);\r\n            }\r\n            catch\r\n            {\r\n                return \"ERROR: Unexpected error reading MCP Action list from Special Identifier\";\r\n            }\r\n        }\r\n    }\r\n}","ID":"60e2ef5e-8674-46ce-9b7c-fa3fc06bdddc","Name":"Get MCP Action ID from Special Identifier","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcplistlookupresult1","ReplacementText":"$scriptresult","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"ff710210-2acb-4f57-938d-2d93ec6e6f00","Name":"Store script result","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":6,"Value1":"$elgatomcplistlookupresult1","Value2":"ERROR","Value3":""}],"CommandID":"00000000-0000-0000-00