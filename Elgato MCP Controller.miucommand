\n    {\r\n        public object Run()\r\n        {\r\n            string batPath = @\"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat\";\r\n\r\n            try\r\n            {\r\n                if (!File.Exists(batPath))\r\n                {\r\n                    File.WriteAllLines(batPath, new string[]\r\n\t\t\t\t\t{\r\n\t\t\t\t\t    \"@echo off\",\r\n\t\t\t\t\t    \"netstat -ano | findstr /R \\\"9090.*LISTENING\\\" >nul 2>&1\",\r\n\t\t\t\t\t    \"if %errorlevel% == 0 (\",\r\n\t\t\t\t\t    \"    echo Stopping Elgato MCP Server...\",\r\n\t\t\t\t\t    \"    for /f \\\"tokens=5\\\" %%a in ('netstat -ano ^| findstr /R \\\"9090.*LISTENING\\\"') do (\",\r\n\t\t\t\t\t    \"        if not \\\"%%a\\\"==\\\"0\\\" (\",\r\n\t\t\t\t\t    \"\\t\\ttaskkill /PID %%a /F\",\r\n\t\t\t\t\t    \"\\t\\tgoto done\",\r\n\t\t\t\t\t    \"\\t\\t)\",\r\n\t\t\t\t\t    \"    )\",\r\n\t\t\t\t\t    \") else (\",\r\n\t\t\t\t\t    \"    echo No process found on port 9090.\",\r\n\t\t\t\t\t    \")\",\r\n\t\t\t\t\t    \":done\",\r\n\t\t\t\t\t    \"exit\"\r\n\t\t\t\t\t});\r\n                    \r\n                    string message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file created: \" + batPath;\r\n                    return null;\r\n                }\r\n                else\r\n                {\r\n                \r\n                \tstring message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file already exists: \" + batPath;\r\n                    return null;\r\n                }\r\n            }\r\n            catch (UnauthorizedAccessException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Permission denied: \" + ex.Message;\r\n            }\r\n            catch (DirectoryNotFoundException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Directory not found: \" + ex.Message;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Unexpected error: \" + ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"4783a48f-c468-487c-8141-f69beabd9c5a","Name":"Create server stop batch file, if doesn't exist","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":false,"ID":"00438aaf-98ad-4922-b6a7-039f35291bf5","Name":"Stop MCP Server","Type":3,"Enabled":true}],"ID":"e271e978-968d-44b9-9942-495d8ff4cd41","Name":"STOP MCP","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcpdebug","Value2":"on","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpmiufolderpath\\debug_specialidentifiers.txt","TransferText":"args: \"$allargs\"","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"f1b3753d-8f20-40b6-8845-776cc0676744","Name":"FOR TESTING - File args","Type":13,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":1,"FilePath":"$elgatomcpmiufolderpath\\debug_specialidentifiers.txt","TransferText":"Value of $ username: \"$username\"","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"59c82fed-93b4-4a87-80be-b3095eff865