th))\r\n                {\r\n                    File.WriteAllLines(batPath, new string[]\r\n                    {\r\n                        \"@echo off\",\r\n                        \"netstat -ano | findstr \\\"LISTENING\\\" | findstr \\\":9090\\\" >nul 2>&1\",\r\n                        \"if %errorlevel% == 0 (\",\r\n                        \"     echo MCP server already running on port 9090\",\r\n                        \") else (\",\r\n                        \"    start \\\"\\\" /min cmd /c \\\"elgato-mcp-server --http\\\"\",\r\n                        \"\\t:: echo Elgato MCP Server running...\",\r\n                        \"    exit\",\r\n                        \")\"\r\n                    });\r\n                    \r\n                    string message = batPath.Replace(dirPath, \"\");\r\n                \r\n                    //return \"Bat file created: \" + message;\r\n                    return null;\r\n                }\r\n                else\r\n                {\r\n                \r\n                \tstring message = batPath.Replace(dirPath, \"\");\r\n                \r\n                    //return \"Bat file already exists: \" + message;\r\n                    return null;\r\n                }\r\n            }\r\n            catch (UnauthorizedAccessException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(dirPath, \"\");\r\n                \r\n                return \"ERROR: Permission denied: \" + ex.Message;\r\n            }\r\n            catch (DirectoryNotFoundException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(dirPath, \"\");\r\n                \r\n                return \"ERROR: Directory not found: \" + ex.Message;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(dirPath, \"\");\r\n                \r\n                return \"ERROR: Unexpected error: \" + ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"6c7ee4d6-9f26-4be2-a6bc-ff9a2a43d7a8","Name":"Create server start batch file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\nusing System.IO;\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            string batPath = @\"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat\";\r\n\r\n            try\r\n            {\r\n                if (!File.Exists(batPath))\r\n                {\r\n                    File.WriteAllLines(batPath, new string[]\r\n\t\t\t\t\t{\r\n\t\t\t\t\t    \"@echo off\",\r\n\t\t\t\t\t    \"netstat -ano | findstr /R \\\"9090.*LISTENING\\\" >nul 2>&1\",\r\n\t\t\t\t\t    \"if %errorlevel% == 0 (\",\r\n\t\t\t\t\t    \"    echo Stopping Elgato MCP Server...\",\r\n\t\t\t\t\t    \"    for /f \\\"tokens=5\\\" %%a in ('netstat -ano ^| findstr /R \\\"9090.*LISTENING\\\"') do (\",\r\n\t\t\t\t\t    \"        if not \\\"%%a\\\"==\\\"0\\\" (\",\r\n\t\t\t\t\t    \"\\t\\ttaskkill /PID %%a /F\",\r\n\t\t\t\t\t    \"\\t\\tgoto done\",\r\n\t\t\t\t\t    \"\\t\\t)\",\r\n\t\t\t\t\t    \"    )\",\r\n\t\t\t\t\t    \") else (\",\r\n\t\t\t\t\t    \"    echo No process found on port 9090.\",\r\n\t\t\t\t\t    \")\",\r\n\t\t\t\t\t    \":done\",\r\n\t\t\t\t\t    \"exit\"\r\n\t\t\t\t\t});\r\n                    \r\n                    string message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file created: \" + batPath;\r\n                    return null;\r\n                }\r\n                else\r\n                {\r\n                \r\n                \tstring message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file already exists: \" + batPath;\r\n                    return null;\r\n                }\r\n            }\r\n            catch (UnauthorizedAccessException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Permission denied: \" + ex.Message;\r\n            }\r\n            catch (DirectoryNotFoundException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Directory not found: \" + ex.Message;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Unexpected error: \" + ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"03f038de-35a3-4ee2-b987-ffa5c80a8a2c","Name":"Create server stop batch file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":false,"ID":"c06c6309-3ecc-40d1-a245-4eb3e4c7c549","Name":"Stop MCP Server","Type":3,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpmiufolderpath\\elgato_mcp_start.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish":false,"SaveOutput":false,"ID":"b3560c62-bd66-4eb5-9ac7-9b75bf6177fc","Name":"Start MCP Server","Type":3,"Enabled":true}],"ID":"cef7ccbb-f369-41f3-9485-cbef627d06e5","Name":"Restart MCP Server","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"C:\\Windows\\System32\\curl.exe","Arguments":"-s -g -X POST -H \"Accept: application/json, text/event-stream\" -H \"Content-Type: application/json\" -d \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\\"initialize\\\",\\\"params\\\":{\\\"protocolVersion\\\":\\\"2024-11-05\\\",\\\"capabilities\\\":{},\\\"clientInfo\\\":{\\\"name\\\":\\\"test\\\",\\\"version\\\":\\\"1.0\\\"}},\\\"id\\\":1}\" -D - -o nul http://$elgatomcpurl/mcp","ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":true,"ID":"a8868b8f-5318-49b1-a874-18aba6ba634b","Name":"Get MCP Server Info","Type":3,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string headers = @\"$externalprogramresult\";\r\n\r\n                string sessionId = null;\r\n                foreach (string line in headers.Split('\\n'))\r\n                {\r\n                    if (line.StartsWith(\"mcp-session-id:\"))\r\n                    {\r\n                        sessionId = line.Split(':')[1].Trim();\r\n                        break;\r\n                    }\r\n                }\r\n\r\n                return sessionId;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                return ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"38551259-d119-4007-8013-c6ac177d6d9f","Name":"Extract MCP Session ID","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpsessionid","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"5299e391-a958-4fe3-a51d-8416eb1d160b","Name":"Save Session ID to Special Identifier","Type":12,"Enabled":true}],"ID":"fc8bd1db-ee0b-4750-9637-662d3a66a6b7","Name":"Get MCP Session ID","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.WebRequestActionModel, MixItUp.Base","Url":"http://$elgatomcpurl/mcp","ResponseType":0,"JSONToSpecialIdentifiers":null,"HttpMethod":1,"CustomHeaders":{"$type":"System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib","Accept":"application/json, text/event-stream","Content-Type":"application/json","mcp-session-id":"$elgatomcpsessionid"},"RequestBody":"{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"streamdeck__get_executable_actions\",\"arguments\":{}},\"id\":3}","ID":"516dc0e5-6bca-4f59-a516-14c3eab36757","Name":"Get MCP Actions data","Type":11,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpmiufolderpath\\mcpactions_json.txt","TransferText":"$webrequestresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"bca3a0df-2553-450c-8f50-e61322e47e20","Name":"Save MCP Actions data to file","Type":13,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero using Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n    \t{\r\n            string raw = System.IO.File.ReadAllText(@\"$elgatomcpmiufolderpath\\mcpactions_json.txt\");\r\n            raw = raw.Replace(\"\\\\n\", \"\").Replace(\"\\\\\\\"\", \"\\\"\");\r\n\r\n            string result = \"\";\r\n            int pos = 0;\r\n\r\n            while (pos < raw.Length)\r\n            {\r\n                // Find title first\r\n                int titleIndex = raw.IndexOf(\"\\\"title\\\": \\\"\", pos);\r\n                if (titleIndex < 0) break;\r\n                int titleStart = titleIndex + 10;\r\n                int titleEnd = raw.IndexOf(\"\\\"\", titleStart);\r\n                if (titleEnd < 0) break;\r\n                string title = raw.Substring(titleStart, titleEnd - titleStart);\r\n                title = title.Trim().ToUpper();\r\n\r\n                // Search BACKWARDS before title for the UUID id\r\n                string id = \"\";\r\n                int searchBack = titleIndex;\r\n                while (searchBack > pos)\r\n                {\r\n                    int idIndex = raw.LastIndexOf(\"\\\"id\\\": \\\"\", searchBack);\r\n                    if (idIndex < pos) break;\r\n                    int idStart = idIndex + 7;\r\n                    if (idStart + 36 > raw.Length) break;\r\n                    string candidate = raw.Substring(idStart, 36);\r\n                    if (candidate[8] == '-' && candidate[13] == '-' && candidate[18] == '-' && candidate[23] == '-')\r\n                    {\r\n                        id = candidate;\r\n                        break;\r\n                    }\r\n                    searchBack = idIndex - 1;\r\n                }\r\n\r\n                if (id != \"\")\r\n                    result += title + \":\" + id + \"\\n\";\r\n\r\n                pos = titleEnd;\r\n            }\r\n\r\n            return result == \"\" ? \"NO RESULTS\" : result;\r\n            \r\n            }\r\n   \t\t\t catch (Exception ex)\r\n    \t\t{\r\n      \t\t  return \"ERROR: \" + ex.Message;\r\n    \t\t}\r\n            \r\n            \r\n        }\r\n    }\r\n}","ID":"581f1f08-5a66-4184-b3e5-436fb2807679","Name":"Parse MCP Actions data from file","Type":38,"Enabled":false},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero using Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n\t\t\r\n            try\r\n            {\r\n                string raw = System.IO.File.ReadAllText(@\"$elgatomcpmiufolderpath\\mcpactions_json.txt\");\r\n                raw = raw.Replace(\"\\\\n\", \"\").Replace(\"\\\\\\\"\", \"\\\"\");\r\n\t\t\t\t\r\n                string result = \"\";\r\n                int pos = 0;\r\n\t\t\t\t\r\n                while (pos < raw.Length)\r\n                {\r\n                    // Find title first\r\n                    int titleIndex = raw.IndexOf(\"\\\"title\\\": \\\"\", pos);\r\n                    if (titleIndex < 0) break;\r\n                    int titleStart = titleIndex + 10;\r\n                    int titleEnd = raw.IndexOf(\"\\\"\", titleStart);\r\n                    if (titleEnd < 0) break;\r\n                    string title = raw.Substring(titleStart, titleEnd - titleStart);\r\n                    title = title.Trim().ToUpper();\r\n\t\t\t\t\t\r\n                    // Search BACKWARDS before title for the UUID id\r\n                    string id = \"\";\r\n                    int searchBack = titleIndex;\r\n                    while (searchBack > pos)\r\n                    {\r\n                        int idIndex = raw.LastIndexOf(\"\\\"id\\\": \\\"\", searchBack);\r\n                        if (idIndex < pos) break;\r\n                        int idStart = idIndex + 7;\r\n                        if (idStart + 36 > raw.Length) break;\r\n                        string candidate = raw.Substring(idStart, 36);\r\n                        if (candidate[8] == '-' && candidate[13] == '-' && candidate[18] == '-' && candidate[23] == '-')\r\n                        {\r\n                            id = candidate;\r\n                            break;\r\n                        }\r\n                        searchBack = idIndex - 1;\r\n                    }\r\n                    if (id != \"\")\r\n                        result += (result == \"\" ? \"{\" : \",\") + \"\\\\\\\"\" + title + \"\\\\\\\":\\\\\\\"\" + id + \"\\\\\\\"\";\r\n                    pos = titleEnd;\r\n                }\r\n                return result == \"\" ? \"NO RESULTS\" : result + \"}\";\r\n            }\r\n            catch (Exception ex)\r\n            {                \r\n\t\t\t\tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                return \"ERROR: \" + message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"18e1cecc-eeb9-4a7a-a092-e46112e35e4d","Name":"Parse MCP Actions data from file - store in JSON","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpactionslist","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"3102ea52-8190-4c3c-8a9c-0853674fa201","Name":"Save MCP Actions list to Special Identifer","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpfilepath\\mcpactions_list.txt","TransferText":"$scriptresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"68bea1e5-8110-45c0-98ab-1fcc7fa246d8","Name":"Save MCP Actions list to file","Type":13,"Enabled":false}],"ID":"5f65c13b-86ed-4bd9-b3a1-8437eba67312","Name":"Refresh Available MCP Actions","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcprestarted","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"384dee41-d422-4d45-aefb-7346b6fb255d","Name":"MCP Server Restarted: TRUE","Type":12,"Enabled":true}],"ID":"c8348437-ea72-4837-a0f9-5568939f7f39","Name":"Restart MCP server if issue or requested","Type":17,"Enabled":true}],"ID":"3adb2a8a-c0da-4f86-8774-bb029898c213","Name":"RESTART MCP SERVER","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcpactionissue","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcprestarted","Value2":"true","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string json = \"$elgatomcpactionslist\";\r\n\r\n                string searchKey = \"$allargs\".Trim().ToUpper();\r\n                string key = \"\\\"\" + searchKey + \"\\\":\\\"\";\r\n                int keyIndex = json.IndexOf(key);\r\n\r\n                if (keyIndex == -1)\r\n                    return \"ERROR: MCP Action \\\"$allargs\\\" not found. Verify MIU command argument matches Stream Deck MCP Action title.\"; \r\n\r\n                int valueStart = keyIndex + key.Length;\r\n                int valueEnd = json.IndexOf('\"', valueStart);\r\n\r\n                if (valueEnd == -1)\r\n                    return \"ERROR: MCP Action list may be corrupt\";\r\n\r\n                return json.Substring(valueStart, valueEnd - valueStart);\r\n            }\r\n            catch\r\n            {\r\n                return \"ERROR: Unexpected error reading MCP Action list from Special Identifier\";\r\n            }\r\n        }\r\n    }\r\n}","ID":"7cb4a2b1-6235-4e4a-9357-0eed25d21fa7","Name":"Get MCP Action ID from Special Identifier","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcplistlookupresult2","ReplacementText":"$scriptresult","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"394ae5e6-6187-434b-918d-d69e7652f93a","Name":"Store script result","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":6,"Value1":"$elgatomcplistlookupresult2","Value2":"ERROR","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcperroractionslist2","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"42a9963e-6cb5-4b25-9341-3f0b317fd2ac","Name":"Error","Type":12,"Enabled":true}],"ID":"46eaf4ce-58ca-4489-8580-daf2da44357f","Name":"If Action not found, error","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcperroractionslist2","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcperrorschat","Value2":"on","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ChatActionModel, MixItUp.Base","ChatText":"$elgatomcplistlookupresult2","SendAsStreamer":false,"IsWhisper":false,"WhisperUserName":null,"ID":"67607c9d-504b-42dc-8b03-a960ce83e036","Name":"Chat Message","Type":1,"Enabled":true}],"ID":"9d797f88-7465-42cf-b981-f47f17c88dc3","Name":"Send error in chat","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":7,"Value1":"$elgatomcplistlookupre