nModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$allargs","Value2":"","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$allargs","Value2":"@$username","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n        {\r\n            string search = \"$allargs\";\r\n            search = search.Trim().ToUpper();\r\n            string[] lines = System.IO.File.ReadAllLines(@\"$elgatomcpfilepath\\mcpactions_list.txt\");\r\n\r\n            foreach (string line in lines)\r\n            {\r\n                int colonIndex = line.IndexOf(\":\");\r\n                if (colonIndex < 0) continue;\r\n\r\n                string key = line.Substring(0, colonIndex).Trim();\r\n                string value = line.Substring(colonIndex + 1).Trim();\r\n\r\n                if (key == search)\r\n                {\r\n                    return value;\r\n                }\r\n            }\r\n\r\n            return \"ERROR: MCP Action \\\"$allargs\\\" not found in list.\";\r\n            \r\n            }\r\n            catch (Exception ex)\r\n\t\t\t{\r\n\t\t\t\tstring message = ex.Message.Replace(@\"$elgatomcpfilepath\\\", \"\");\r\n                return \"ERROR: \" + message;\r\n\t\t\t}\r\n            \r\n        }\r\n    }\r\n}","ID":"07f457b5-26fc-41f8-b8f1-5d72ad0dccbd","Name":"Get MCP Action ID from file","Type":38,"Enabled":false},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string json = \"$elgatomcpactionslist\";\r\n\r\n                string searchKey = \"$allargs\".Trim().ToUpper();\r\n                string key = \"\\\"\" + searchKey + \"\\\":\\\"\";\r\n                int keyIndex = json.IndexOf(key);\r\n\r\n                if (keyIndex == -1)\r\n                    return \"ERROR: MCP Action \\\"$allargs\\\" not found in list\";\r\n\r\n                int valueStart = keyIndex + key.Length;\r\n                int valueEnd = json.IndexOf('\"', valueStart);\r\n\r\n                if (valueEnd == -1)\r\n                    return \"ERROR: MCP Action list may be corrupt\";\r\n\r\n                return json.Substring(valueStart, valueEnd - valueStart);\r\n            }\r\n            catch\r\n            {\r\n                return \"ERROR: Unexpected error reading MCP Action list from Special Identifier\";\r\n            }\r\n        }\r\n    }\r\n}","ID":"33cc26d3-6617-49a7-ba02-42f7a82492a2","Name":"Get MCP Action ID from Special Identifier","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcplistlookupresult1","ReplacementText":"$scriptresult","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"53d32e58-9746-4428-a1a5-045c2e4c1dcf","Name":"Store script result","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":6,"Value1":"$elgatomcplistlookupresult1","Value2":"ERROR","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","Spe