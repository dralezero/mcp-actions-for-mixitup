ype":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\nusing System.IO;\r\n            \r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try{\r\n            \r\n            string elgatomcpmiufolderpath = @\"$elgatomcpmiubasepath\"; // MixItUp variable\r\n\r\n\t\t\tstring batPath;\r\n\t\t\tstring dirPath;\r\n\t\t\t\r\n\t\t\tif (string.IsNullOrEmpty(elgatomcpmiufolderpath) \r\n    \t\t|| elgatomcpmiufolderpath.Equals(\"%LOCALAPPDATA%\", StringComparison.OrdinalIgnoreCase))\t\t\t\r\n\t\t\t{\r\n\t\t\t    string appData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);\r\n\t\t\t    dirPath = Path.Combine(appData, \"MixItUpElgatoMCP\");\r\n\t\t\t\r\n\t\t\t    if (!Directory.Exists(dirPath))\r\n\t\t\t    {\r\n\t\t\t        Directory.CreateDirectory(dirPath);\r\n\t\t\t    }\r\n\t\t\t}else\r\n\t\t\t{\r\n\t\t\t    dirPath = Path.Combine(elgatomcpmiufolderpath, \"MixItUpElgatoMCP\");\r\n\t\t\t\r\n\t\t\t    if (!Directory.Exists(dirPath))\r\n\t\t\t    {\r\n\t\t\t        Directory.CreateDirectory(dirPath);\r\n\t\t\t    }\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t\treturn dirPath;\r\n\t\t\t\r\n\t\t\t}catch{\r\n\t\t\t\treturn null;\r\n\t\t\t}\r\n        }\r\n    }\r\n}","ID":"9f1d5176-4643-4f1d-a886-5c74aa9370ca","Name":"Build folder path","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpmiufolderpath","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"c70eac61-ee67-48b8-a5d1-c9280b2c2c9b","Name":"Save folder path to Special Identifier","Type":12,"Enabled":true}],"ID":"f8f480c1-98c7-4ed5-95e6-32eed1326730","Name":"PROCESS CONFIG","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$allargs","Value2":"elgatomcpstop","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":7,"Value1":"$elgatomcpactionslist","Value2":"{","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpbeforerunactionslist","ReplacementText":"empty","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"43001c17-79be-4c7b-9bfb-a043b6717c21","Name":"Special Identifier","Type":12,"Enabled":true}],"ID":"ad99a3e1-2f2d-4991-a6f2-1d6f066f77b4","Name":"Conditional","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":6,"Value1":"$elgatomcpactionslist","Value2":"{","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpbeforerunactionslist","ReplacementText":"$elgatomcpactionslist","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"2929868f-7cc3-4ca1-965e-5979728671c9","Name":"Special Identifier","Type":12,"Enabled":true}],"ID":"0d618b59-8d6c-457d-af50-ba849f28e1a9","Name":"Conditional","Type":17,"Enabled":true}],"ID":"55b1d5c6-af37-4a4a-a8a3-d90c67a664e1","Name":"Store mcp action list state prior to run","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$allargs","Value2":"","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$allargs","Value2":"@$username","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":7,"Value1":"$elgatomcpactionslist","Value2":"{","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcperroractionslist1","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"cad1be1c-2942-4157-9e57-efed05530158","Name":"Special Identifier","Type":12,"Enabled":true}],"ID":"c8c91383-d795-4a68-be26-daf9174633cd","Name":"If button title arg received but action list empty","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$allargs","Value2":"","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$allargs","Value2":"@$username","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":6,"Value1":"$elgatomcpactionslist","Value2":"{","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n        {\r\n            string search = \"$allargs\";\r\n            search = search.Trim().ToUpper();\r\n            string[] lines = System.IO.File.ReadAllLines(@\"$elgatomcpmiufolderpath\\mcpactions_list.txt\");\r\n\r\n            foreach (string line in lines)\r\n            {\r\n                int colonIndex = line.IndexOf(\":\");\r\n                if (colonIndex < 0) continue;\r\n\r\n                string key = line.Substring(0, colonIndex).Trim();\r\n                string value = line.Substring(colonIndex + 1).Trim();\r\n\r\n                if (key == search)\r\n                {\r\n                    return value;\r\n                }\r\n            }\r\n\r\n            return \"ERROR: MCP Action \\\"$allargs\\\" not found in list.\";\r\n            \r\n            }\r\n            catch (Exception ex)\r\n\t\t\t{\r\n\t\t\t\tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                return \"ERROR: \" + message;\r\n\t\t\t}\r\n            \r\n        }\r\n    }\r\n}","ID":"44385e38-0bba-413d-b06c-aa2b9571e310","Name":"Get MCP Action ID from file","Type":38,"Enabled":false},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string json = \"$elgatomcpactionslist\";\r\n                \r\n                if (string.IsNullOrEmpty(json))\r\n                    return \"ERROR: MCP Action list is empty or not set\";\r\n\r\n                string searchKey = \"$allargs\".Trim().ToUpper();\r\n                string key = \"\\\"\" + searchKey + \"\\\":\\\"\";\r\n                int keyIndex = json.IndexOf(key);\r\n\r\n                if (keyIndex == -1)\r\n                    return \"ERROR: MCP Action \\\"$allargs\\\" not found in list\";\r\n\r\n                int valueStart = keyIndex + key.Length;\r\n                int valueEnd = json.IndexOf('\"', valueStart);\r\n\r\n                if (valueEnd == -1)\r\n                    return \"ERROR: MCP Action list may be corrupt\";\r\n\r\n                return json.Substring(valueStart, valueEnd - valueStart);\r\n            }\r\n            catch\r\n            {\r\n                return \"ERROR: Unexpected error reading MCP Action list from Special Identifier\";\r\n            }\r\n        }\r\n    }\r\n}","ID":"a420f508-e63f-42a2-add0-e3da73365e4b","Name":"Get MCP Action ID from Special Identifier","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcplistlookupresult1","ReplacementText":"$scriptresult","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"7b39d219-79a2-407c-a1a1-bbc432a319ff","Name":"Store script result","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":6,"Value1":"$elgatomcplistlookupresult1","Value2":"ERROR","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcperroractionslist1","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"88b11df8-1f52-4b2c-87b4-16073f5fc5b9","Name":"Error","Type":12,"Enabled":true}],"ID":"9fc02a5a-2c47-469c-aa44-18fa044c045f","Name":"If Action not found, error","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcperroractionslist1","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcperrorschat","Value2":"on","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ChatActionModel, MixItUp.Base","ChatText":"$elgatomcplistlookupresult1","SendAsStreamer":false,"IsWhisper":false,"WhisperUserName":null,"ID":"ccbaa89c-5085-46d6-9dda-8b37c660c21a","Name":"Chat Message","Type":1,"Enabled":true}],"ID":"8b63d683-46a7-4f22-9ae0-e721f58fd77f","Name":"Send error in chat","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$elgatomcperroractionslist1","Value2":"true","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"webrequestresult","ReplacementText":"failed","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"bd479c33-7f97-45a7-ba6e-87d409852994","Name":"Mark web failed - gets replaced if successful","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcptriggeractionresult1","ReplacementText":"failed","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"16b79b62-bbc3-4d33-a542-5470723e67f7","Name":"Ma