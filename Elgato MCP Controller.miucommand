h, new string[]\r\n                    {\r\n                        \"@echo off\",\r\n                        \"netstat -ano | findstr \\\"LISTENING\\\" | findstr \\\":9090\\\" >nul 2>&1\",\r\n                        \"if %errorlevel% == 0 (\",\r\n                        \"     echo MCP server already running on port 9090\",\r\n                        \") else (\",\r\n                        \"    start \\\"\\\" /min cmd /c \\\"elgato-mcp-server --http\\\"\",\r\n                        \"\\t:: echo Elgato MCP Server running...\",\r\n                        \"    exit\",\r\n                        \")\"\r\n                    });\r\n                    \r\n                    string message = batPath.Replace(dirPath, \"\");\r\n                \r\n                    //return \"Bat file created: \" + message;\r\n                    return null;\r\n                }\r\n                else\r\n                {\r\n                \r\n                \tstring message = batPath.Replace(dirPath, \"\");\r\n                \r\n                    //return \"Bat file already exists: \" + message;\r\n                    return null;\r\n                }\r\n            }\r\n            catch (UnauthorizedAccessException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(dirPath, \"\");\r\n                \r\n                return \"ERROR: Permission denied: \" + ex.Message;\r\n            }\r\n            catch (DirectoryNotFoundException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(dirPath, \"\");\r\n                \r\n                return \"ERROR: Directory not found: \" + ex.Message;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(dirPath, \"\");\r\n                \r\n                return \"ERROR: Unexpected error: \" + ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"bd55e452-b375-430a-b577-962e2798f8a5","Name":"Create server start batch file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\nusing System.IO;\r\n//made by DraleZero using Claude\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            string batPath = @\"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat\";\r\n\r\n            try\r\n            {\r\n                if (!File.Exists(batPath))\r\n                {\r\n                    File.WriteAllLines(batPath, new string[]\r\n\t\t\t\t\t{\r\n\t\t\t\t\t    \"@echo off\",\r\n\t\t\t\t\t    \"netstat -ano | findstr /R \\\"9090.*LISTENING\\\" >nul 2>&1\",\r\n\t\t\t\t\t    \"if %errorlevel% == 0 (\",\r\n\t\t\t\t\t    \"    echo Stopping Elgato MCP Server...\",\r\n\t\t\t\t\t    \"    for /f \\\"tokens=5\\\" %%a in ('netstat -ano ^| findstr /R \\\"9090.*LISTENING\\\"') do (\",\r\n\t\t\t\t\t    \"        if not \\\"%%a\\\"==\\\"0\\\" (\",\r\n\t\t\t\t\t    \"\\t\\ttaskkill /PID %%a /F\",\r\n\t\t\t\t\t    \"\\t\\tgoto done\",\r\n\t\t\t\t\t    \"\\t\\t)\",\r\n\t\t\t\t\t    \"    )\",\r\n\t\t\t\t\t    \") else (\",\r\n\t\t\t\t\t    \"    echo No process found on port 9090.\",\r\n\t\t\t\t\t    \")\",\r\n\t\t\t\t\t    \":done\",\r\n\t\t\t\t\t    \"exit\"\r\n\t\t\t\t\t});\r\n                    \r\n                    string message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file created: \" + batPath;\r\n                    return null;\r\n                }\r\n                else\r\n                {\r\n                \r\n                \tstring message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file already exists: \" + batPath;\r\n                    return null;\r\n                }\r\n            }\r\n            catch (UnauthorizedAccessException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Permission denied: \" + ex.Message;\r\n            }\r\n            catch (DirectoryNotFoundException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Directory not found: \" + ex.Message;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Unexpected error: \" + ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"5634ff9d-0247-4051-b8cf-3d4a33b106d6","Name":"Create server stop batch file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":false,"ID":"c06c6309-3ecc-40d1-a245-4eb3e4c7c549","Name":"Stop MCP Server","Type":3,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpmiufolderpath\\elgato_mcp_start.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish":false,"SaveOutput":false,"ID":"b3560c62-bd66-4eb5-9ac7-9b75bf6177fc","Name":"Start MCP Server","Type":3,"Enabled":true}],"ID":"76c64b08-3ddc-4a04-b410-ac04bdac1ff4","Name":"Restart MCP Server","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"C:\\Windows\\System32\\curl.exe","Arguments":"-s -g -X POST -H \"Accept: application/json, text/event-stream\" -H \"Content-Type: application/json\" -d \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\\"initialize\\\",\\\"params\\\":{\\\"protocolVersion\\\":\\\"2024-11-05\\\",\\\"capabilities\\\":{},\\\"clientInfo\\\":{\\\"name\\\":\\\"test\\\",\\\"version\\\":\\\"1.0\\\"}},\\\"id\\\":1}\" -D - -o nul http://$elgatomcpurl/mcp","ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":true,"ID":"202af945-6b94-4287-a8b2-30de05dfc09a","Name":"Get MCP Server Info","Type":3,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string headers = @\"$externalprogramresult\";\r\n\r\n                string sessionId = null;\r\n                foreach (string line in headers.Split('\\n'))\r\n                {\r\n                    if (line.StartsWith(\"mcp-session-id:\"))\r\n                    {\r\n                        sessionId = line.Split(':')[1].Trim();\r\n                        break;\r\n                    }\r\n                }\r\n\r\n                return sessionId;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                return ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"e5efd16b-73ad-4f53-bf7f-1bb88244fb13","Name":"Extract MCP Session ID","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpsessionid","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"5299e391-a958-4fe3-a51d-8416eb1d160b","Name":"Save Session ID to Special Identifier","Type":12,"Enabled":true}],"ID":"f46f157c-674a-4c5a-8510-88e2ecc47322","Name":"Get MCP Session ID","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.WebRequestActionModel, MixItUp.Base","Url":"http://$elgatomcpurl/mcp","ResponseType":0,"JSONToSpecialIdentifiers":null,"HttpMethod":1,"CustomHeaders":{"$type":"System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib","Accept":"application/json, text/event-stream","Content-Type":"application/json","mcp-session-id":"$elgatomcpsessionid"},"RequestBody":"{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"streamdeck__get_executable_actions\",\"arguments\":{}},\"id\":3}","ID":"d3e520b8-a74f-412f-ae1b-b4f9f21bb646","Name":"Get MCP Actions data","Type":11,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpmiufolderpath\\mcpactions_json.txt","TransferText":"$webrequestresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"5b082e84-1088-4cf6-abd3-474dbf97ce9a","Name":"Save MCP Actions data to file","Type":13,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero using Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n\t\t\r\n            try\r\n            {\r\n                string raw = System.IO.File.ReadAllText(@\"$elgatomcpmiufolderpath\\mcpactions_json.txt\");\r\n                raw = raw.Replace(\"\\\\n\", \"\").Replace(\"\\\\\\\"\", \"\\\"\");\r\n\t\t\t\t\r\n                string result = \"\";\r\n                int pos = 0;\r\n\t\t\t\t\r\n                while (pos < raw.Length)\r\n                {\r\n                    // Find title first\r\n                    int titleIndex = raw.IndexOf(\"\\\"title\\\": \\\"\", pos);\r\n                    if (titleIndex < 0) break;\r\n                    int titleStart = titleIndex + 10;\r\n                    int titleEnd = raw.IndexOf(\"\\\"\", titleStart);\r\n                    if (titleEnd < 0) break;\r\n                    string title = raw.Substring(titleStart, titleEnd - titleStart);\r\n                    title = title.Trim().ToUpper();\r\n\t\t\t\t\t\r\n                    // Search BACKWARDS before title for the UUID id\r\n                    string id = \"\";\r\n                    int searchBack = titleIndex;\r\n                    while (searchBack > pos)\r\n                    {\r\n                        int idIndex = raw.LastIndexOf(\"\\\"id\\\": \\\"\", searchBack);\r\n                        if (idIndex < pos) break;\r\n                        int idStart = idIndex + 7;\r\n                        if (idStart + 36 > raw.Length) break;\r\n                        string candidate = raw.Substring(idStart, 36);\r\n                        if (candidate[8] == '-' && candidate[13] == '-' && candidate[18] == '-' && candidate[23] == '-')\r\n                        {\r\n                            id = candidate;\r\n                            break;\r\n                        }\r\n                        searchBack = idIndex - 1;\r\n                    }\r\n                    if (id != \"\")\r\n                        result += (result == \"\" ? \"{\" : \",\") + \"\\\\\\\"\" + title + \"\\\\\\\":\\\\\\\"\" + id + \"\\\\\\\"\";\r\n                    pos = titleEnd;\r\n                }\r\n                return result == \"\" ? \"NO RESULTS\" : result + \"}\";\r\n            }\r\n            catch (Exception ex)\r\n            {                \r\n\t\t\t\tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                return \"ERROR: \" + message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"d9751cce-3fa2-41b8-a001-33f22908e663","Name":"Parse MCP Actions data from file - store in JSON","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpactionslist","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"3102ea52-8190-4c3c-8a9c-0853674fa201","Name":"Save MCP Actions list to Special Identifer","Type":12,"Enabled":true}],"ID":"2bc4f0c9-8ba1-4a5d-9b32-fe73c1cca576","Name":"Refresh Available MCP Actions","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcprestarted","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"6d1a1005-23fe-4268-8c24-6895e2dd91de","Name":"MCP Server Restarted: TRUE","Type":12,"Enabled":true}],"ID":"93227f84-d1db-46c7-bfbf-5c08e8891587","Name":"Restart MCP server if issue or requested","Type":17,"Enabled":true}],"ID":"f9595604-3a24-41b5-8dd7-8bb863e913f6","Name":"RESTART MCP SERVER","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcpactionissue","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcprestarted","Value2":"true","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n//made by DraleZero using Claude\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string json = \"$elgatomcpactionslist\";\r\n\r\n                string searchKey = \"$allargs\".Trim().ToUpper();\r\n                string key = \"\\\"\" + searchKey + \"\\\":\\\"\";\r\n                int keyIndex = json.IndexOf(key);\r\n\r\n                if (keyIndex == -1)\r\n                    return \"ERROR: MCP Action \\\"$allargs\\\" not found. Verify MIU command argument matches Stream Deck MCP Action title.\"; \r\n\r\n                int valueStart = keyIndex + key.Length;\r\n                int valueEnd = json.IndexOf('\"', valueStart);\r\n\r\n                if (valueEnd == -1)\r\n                    return \"ERROR: MCP Action list may be corrupt\";\r\n\r\n                return json.Substring(valueStart, valueEnd - valueStart);\r\n            }\r\n            catch\r\n            {\r\n                return \"ERROR: Unexpected error reading MCP Action list from Special Identifier\";\r\n            }\r\n        }\r\n    }\r\n}","ID":"b2d065a8-e856-4eba-86ed-08d5993b8a0f","Name":"Get MCP Action ID from Special Identifier","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcplistlookupresult2","ReplacementText":"$scriptresult","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"e2777a6c-c986-4610-b92b-615a3a78b4a7","Name":"Store script result","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":6,"Value1":"$elgatomcplistlookupresult2","Value2":"ERROR","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcperroractionslist2","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"42a9963e-6cb5-4b25-9341-3f0b317fd2ac","Name":"Error","Type":12,"Enabled":true}],"ID":"06c4b337-02ee-4d90-b34e-f97cd7a698de","Name":"If Action not found, error","Type":17,"Enable