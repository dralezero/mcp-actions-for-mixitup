ixItUp.Base","ActionType":1,"FilePath":"$elgatomcpmiufolderpath\\debug_specialidentifiers.txt","TransferText":"elgatomcperroractionslist2: $elgatomcperroractionslist2","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"2f02cf12-4679-43f9-8af1-4760e2a0d55b","Name":"FOR TESTING - File elgatomcperroractionslist2","Type":13,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":1,"FilePath":"$elgatomcpmiufolderpath\\debug_specialidentifiers.txt","TransferText":"elgatomcptriggeractionjson2: $elgatomcptriggeractionjson2","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"5ce9b16e-cdc8-4e52-9074-631a7d9fe9f7","Name":"FOR TESTING - File elgatomcptriggeractionjson2","Type":13,"Enabled":true}],"ID":"d946f256-d81c-4ca4-adad-e388605f299d","Name":"If debug on","Type":17,"Enabled":true}],"ID":"d0c50c58-2231-408f-85c1-a2a36b2aff22","Name":"RESTART MCP OR TRIGGER ACTION","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":1,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$allargs","Value2":"elgatomcpstop","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\nusing System.IO;\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            string batPath = @\"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat\";\r\n\r\n            try\r\n            {\r\n                if (!File.Exists(batPath))\r\n                {\r\n                    File.WriteAllLines(batPath, new string[]\r\n\t\t\t\t\t{\r\n\t\t\t\t\t    \"@echo off\",\r\n\t\t\t\t\t    \"netstat -ano | findstr /R \\\"9090.*LISTENING\\\" >nul 2>&1\",\r\n\t\t\t\t\t    \"if %errorlevel% == 0 (\",\r\n\t\t\t\t\t    \"    echo Stopping Elgato MCP Server...\",\r\n\t\t\t\t\t    \"    for /f \\\"tokens=5\\\" %%a in ('netstat -ano ^| findstr /R \\\"9090.*LISTENING\\\"') do (\",\r\n\t\t\t\t\t    \"        if not \\\"%%a\\\"==\\\"0\\\" (\",\r\n\t\t\t\t\t    \"\\t\\ttaskkill /PID %%a /F\",\r\n\t\t\t\t\t    \"\\t\\tgoto done\",\r\n\t\t\t\t\t    \"\\t\\t)\",\r\n\t\t\t\t\t    \"    )\",\r\n\t\t\t\t\t    \") else (\",\r\n\t\t\t\t\t    \"    echo No process found on port 9090.\",\r\n\t\t\t\t\t    \")\",\r\n\t\t\t\t\t    \":done\",\r\n\t\t\t\t\t    \"exit\"\r\n\t\t\t\t\t});\r\n                    \r\n                    string message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file created: \" + batPath;\r\n                    return null;\r\n                }\r\n                else\r\n                {\r\n                \r\n                \tstring message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file already exists: \" + batPath;\r\n                    return null;\r\n                }\r\n            }\r\n            catch (UnauthorizedAccessException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Permission denied: \" + ex.Message;\r\n            }\r\n            catch (DirectoryNotFoundException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Directory not found: \" + ex.Message;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Unexpected error: \" + ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"3315d2c3-2576-4d1b-9792-4573ce71e05d","Name":"Create server stop batch file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":false,"ID":"00438aaf-98ad-4922-b6a7-039f35291bf5","Name":"Stop MCP Server","Type":3,"Enabled":true}],"ID":"808d3e4a-a14f-4694-8c0e-9f859019353a","Name":"STOP MCP","Type":17,"Enabled":true}]}
