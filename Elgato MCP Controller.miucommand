},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\nusing System.IO;\r\n            \r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try{\r\n            \r\n            string elgatomcpmiufolderpath = @\"$elgatomcpmiubasepath\"; // MixItUp variable\r\n\r\n\t\t\tstring batPath;\r\n\t\t\tstring dirPath;\r\n\t\t\t\r\n\t\t\tif (string.IsNullOrEmpty(elgatomcpmiufolderpath) \r\n    \t\t|| elgatomcpmiufolderpath.Equals(\"%LOCALAPPDATA%\", StringComparison.OrdinalIgnoreCase))\t\t\t\r\n\t\t\t{\r\n\t\t\t    string appData = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData);\r\n\t\t\t    dirPath = Path.Combine(appData, \"MixItUpElgatoMCP\");\r\n\t\t\t\r\n\t\t\t    if (!Directory.Exists(dirPath))\r\n\t\t\t    {\r\n\t\t\t        Directory.CreateDirectory(dirPath);\r\n\t\t\t    }\r\n\t\t\t}else\r\n\t\t\t{\r\n\t\t\t    dirPath = Path.Combine(elgatomcpmiufolderpath, \"MixItUpElgatoMCP\");\r\n\t\t\t\r\n\t\t\t    if (!Directory.Exists(dirPath))\r\n\t\t\t    {\r\n\t\t\t        Directory.CreateDirectory(dirPath);\r\n\t\t\t    }\r\n\t\t\t}\r\n\t\t\t\r\n\t\t\t\treturn dirPath;\r\n\t\t\t\r\n\t\t\t}catch{\r\n\t\t\t\treturn null;\r\n\t\t\t}\r\n        }\r\n    }\r\n}","ID":"9f1d5176-4643-4f1d-a886-5c74aa9370ca","Name":"Build folder path","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpmiufolderpath","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"c70eac61-ee67-48b8-a5d1-c9280b2c2c9b","Name":"Save folder path to Special Identifier","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.A