0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpactionissue","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"1af2ae0c-c37a-4627-9aa8-68b4e4dd85f6","Name":"Issue with action","Type":12,"Enabled":true}],"ID":"24c16fdc-9f4a-4264-abfa-3cc484c4cdab","Name":"Errors that define action issue, need a restart","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":1,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcpactionissue","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcprestartrequested","Value2":"true","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\nusing System.IO;\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {   \r\n            string batPath = string.Empty;\r\n\t\t\tstring dirPath = string.Empty;\r\n            try\r\n            {\r\n            \r\n            \tdirPath = @\"$elgatomcpmiufolderpath\";\r\n\t\t\t    batPath = Path.Combine(dirPath, \"elgato_mcp_start.bat\");\r\n            \r\n                if (!File.Exists(batPath))\r\n                {\r\n                    File.WriteAllLines(batPath, new string[]\r\n                    {\r\n                        \"@echo off\",\r\n                        \"netstat -ano | findstr \\\"LISTENING\\\" | findstr \\\":9090\\\" >nul 2>&1\",\r\n                        \"if %errorlevel% == 0 (\",\r\n                        \"     echo MCP server already running on port 9090\",\r\n                        \") else (\",\r\n                        \"    start \\\"\\\" /min cmd /c \\\"elgato-mcp-server --http\\\"\",\r\n                        \"\\t:: echo Elgato MCP Server running...\",\r\n                        \"    exit\",\r\n                        \")\"\r\n                    });\r\n                    \r\n                    string message = batPath.Replace(dirPath, \"\");\r\n                \r\n                    //return \"Bat file created: \" + message;\r\n                    return null;\r\n                }\r\n                else\r\n                {\r\n                \r\n                \tstring message = batPath.Replace(dirPath, \"\");\r\n                \r\n                    //return \"Bat file already exists: \" + message;\r\n                    return null;\r\n                }\r\n            }\r\n            catch (UnauthorizedAccessException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(dirPath, \"\");\r\n                \r\n                return \"ERROR: Permission denied: \" + ex.Message;\r\n            }\r\n            catch (DirectoryNotFoundException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(dirPath, \"\");\r\n                \r\n                return \"ERROR: Directory not found: \" + ex.Message;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(dirPath, \"\");\r\n                \r\n                return \"ERROR: Unexpected error: \" + ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"6c7ee4d6-9f26-4be2-a6bc-ff9a2a43d7a8","Name":"Create server start batch file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\nusing System.IO;\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            string batPath = @\"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat\";\r\n\r\n            try\r\n            {\r\n                if (!File.Exists(batPath))\r\n                {\r\n                    File.WriteAllLines(batPath, new string[]\r\n\t\t\t\t\t{\r\n\t\t\t\t\t    \"@echo off\",\r\n\t\t\t\t\t    \"netstat -ano | findstr /R \\\"9090.*LISTENING\\\" >nul 2>&1\",\r\n\t\t\t\t\t    \"if %errorlevel% == 0 (\",\r\n\t\t\t\t\t    \"    echo Stopping Elgato MCP Server...\",\r\n\t\t\t\t\t    \"    for /f \\\"tokens=5\\\" %%a in ('netstat -ano ^| findstr /R \\\"9090.*LISTENING\\\"') do (\",\r\n\t\t\t\t\t    \"        if not \\\"%%a\\\"==\\\"0\\\" (\",\r\n\t\t\t\t\t    \"\\t\\ttaskkill /PID %%a /F\",\r\n\t\t\t\t\t    \"\\t\\tgoto done\",\r\n\t\t\t\t\t    \"\\t\\t)\",\r\n\t\t\t\t\t    \"    )\",\r\n\t\t\t\t\t    \") else (\",\r\n\t\t\t\t\t    \"    echo No process found on port 9090.\",\r\n\t\t\t\t\t    \")\",\r\n\t\t\t\t\t    \":done\",\r\n\t\t\t\t\t    \"exit\"\r\n\t\t\t\t\t});\r\n                    \r\n                    string message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file created: \" + batPath;\r\n                    return null;\r\n                }\r\n                else\r\n                {\r\n                \r\n                \tstring message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file already exists: \" + batPath;\r\n                    return null;\r\n                }\r\n            }\r\n            catch (UnauthorizedAccessException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Permission denied: \" + ex.Message;\r\n            }\r\n            catch (DirectoryNotFoundException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Directory not found: \" + ex.Message;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Unexpected error: \" + ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"03f038de-35a3-4ee2-b987-ffa5c80a8a2c","Name":"Create server stop batch file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":false,"ID":"c06c6309-3ecc-40d1-a245-4eb3e4c7c549","Name":"Stop MCP Server","Type":3,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpmiufolderpath\\elgato_mcp_start.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish":false,"SaveOutput":false,"ID":"b3560c62-bd66-4eb5-9ac7-9b75bf6177fc","Name":"Start MCP Server","Type":3,"Enabled":true}],"ID":"ae0f243c-9abe-410e-a431-063a348e1e85","Name":"Restart MCP Server","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"C:\\Windows\\System32\\curl.exe","Arguments":"-s -g -X POST -H \"Accept: application/json, text/event-stream\" -H \"Content-Type: application/json\" -d \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\\"initialize\\\",\\\"params\\\":{\\\"protocolVersion\\\":\\\"2024-11-05\\\",\\\"capabilities\\\":{},\\\"clientInfo\\\":{\\\"name\\\":\\\"test\\\",\\\"version\\\":\\\"1.0\\\"}},\\\"id\\\":1}\" -D - -o nul http://$elgatomcpurl/mcp","ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":true,"ID":"f9aefaa3-e1b1-4194-9ca5-08d2a8776826","Name":"Get MCP Server Info","Type":3,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string headers = @\"$externalprogramresult\";\r\n\r\n                string sessionId = null;\r\n                foreach (string line in headers.Split('\\n'))\r\n                {\r\n                    if (line.StartsWith(\"mcp-session-id:\"))\r\n                    {\r\n                        sessionId = line.Split(':')[1].Trim();\r\n                        break;\r\n                    }\r\n                }\r\n\r\n                return sessionId;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                return ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"38551259-d119-4007-8013-c6ac177d6d9f","Name":"Extract MCP Session ID","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpsessionid","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"5299e391-a958-4fe3-a51d-8416eb1d160b","Name":"Save Session ID to Special Identifier","Type":12,"Enabled":true}],"ID":"5f66a17d-37fd-438d-a973-607f8f4c2202","Name":"Get MCP Session ID","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.WebRequestActionModel, MixItUp.Base","Url":"http://$elgatomcpurl/mcp","ResponseType":0,"JSONToSpecialIdentifiers":null,"HttpMethod":1,"CustomHeaders":{"$type":"System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib","Accept":"application/json, text/event-stream","Content-Type":"application/json","mcp-session-id":"$elgatomcpsessionid"},"RequestBody":"{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"streamdeck__get_executable_actions\",\"arguments\":{}},\"id\":3}","ID":"516dc0e5-6bca-4f59-a516-14c3eab36757","Name":"Get MCP Actions data","Type":11,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpmiufolderpath\\mcpactions_json.txt","TransferText":"$webrequestresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"bca3a0df-2553-450c-8f50-e61322e47e20","Name":"Save MCP Actions data to file","Type":13,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero using Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n    \t{\r\n            string raw = System.IO.File.ReadAllText(@\"$elgatomcpmiufolderpath\\mcpactions_json.txt\");\r\n            raw = raw.Replace(\"\\\\n\", \"\").Replace(\"\\\\\\\"\", \"\\\"\");\r\n\r\n            string result = \"\";\r\n            int pos = 0;\r\n\r\n            while (pos < raw.Length)\r\n            {\r\n                // Find title first\r\n                int titleIndex = raw.IndexOf(\"\\\"title\\\": \\\"\", pos);\r\n                if (titleIndex < 0) break;\r\n                int titleStart = titleIndex + 10;\r\n                int titleEnd = raw.IndexOf(\"\\\"\", titleStart);\r\n                if (titleEnd < 0) break;\r\n                string title = raw.Substring(titleStart, titleEnd - titleStart);\r\n                title = title.Trim().ToUpper();\r\n\r\n                // Search BACKWARDS before title for the UUID id\r\n                string id = \"\";\r\n                int searchBack = titleIndex;\r\n                while (searchBack > pos)\r\n                {\r\n                    int idIndex = raw.LastIndexOf(\"\\\"id\\\": \\\"\", searchBack);\r\n                    if (idIndex < pos) break;\r\n                    int idStart = idIndex + 7;\r\n                    if (idStart + 36 > raw.Length) break;\r\n                    string candidate = raw.Substring(idStart, 36);\r\n                    if (candidate[8] == '-' && candidate[13] == '-' && candidate[18] == '-' && candidate[23] == '-')\r\n                    {\r\n                        id = candidate;\r\n                        break;\r\n                    }\r\n                    searchBack = idIndex - 1;\r\n                }\r\n\r\n                if (id != \"\")\r\n                    result += title + \":\" + id + \"\\n\";\r\n\r\n                pos = titleEnd;\r\n            }\r\n\r\n            return result == \"\" ? \"NO RESULTS\" : result;\r\n            \r\n            }\r\n   \t\t\t catch (Exception ex)\r\n    \t\t{\r\n      \t\t  return \"ERROR: \" + ex.Message;\r\n    \t\t}\r\n            \r\n            \r\n        }\r\n    }\r\n}","ID":"581f1f08-5a66-4184-b3e5-436fb2807679","Name":"Parse MCP Actions data from file","Type":38,"Enabled":false},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero using Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n\t\t\r\n            try\r\n            {\r\n                string raw = System.IO.File.ReadAllText(@\"$elgatomcpmiufolderpath\\mcpactions_json.txt\");\r\n                raw = raw.Replace(\"\\\\n\", \"\").Replace(\"\\\\\\\"\", \"\\\"\");\r\n\t\t\t\t\r\n                string result = \"\";\r\n                int pos = 0;\r\n\t\t\t\t\r\n                while (pos < raw.Length)\r\n                {\r\n                    // Find title first\r\n                    int titleIndex = raw.IndexOf(\"\\\"title\\\": \\\"\", pos);\r\n                    if (titleIndex < 0) break;\r\n                    int titleStart = titleIndex + 10;\r\n                    int titleEnd = raw.IndexOf(\"\\\"\", titleStart);\r\n                    if (titleEnd < 0) break;\r\n                    string title = raw.Substring(titleStart, titleEnd - titleStart);\r\n                    title = title.Trim().ToUpper();\r\n\t\t\t\t\t\r\n                    // Search BACKWARDS before title for the UUID id\r\n                    string id = \"\";\r\n                    int searchBack = titleIndex;\r\n                    while (searchBack > pos)\r\n                    {\r\n                        int idIndex = raw.LastIndexOf(\"\\\"id\\\": \\\"\", searchBack);\r\n                        if (idIndex < pos) break;\r\n                        int idStart = idIndex + 7;\r\n                        if (idStart + 36 > raw.Length) break;\r\n                        string candidate = raw.Substring(idStart, 36);\r\n                        if (candidate[8] == '-' && candidate[13] == '-' && candidate[18] == '-' && candidate[23] == '-')\r\n                        {\r\n                            id = candidate;\r\n                            break;\r\n                        }\r\n                        searchBack = idIndex - 1;\r\n                    }\r\n                    if (id != \"\")\r\n                        result += (result == \"\" ? \"{\" : \",\") + \"\\\\\\\"\" + title + \"\\\\\\\":\\\\\\\"\" + id + \"\\\\\\\"\";\r\n                    pos = titleEnd;\r\n                }\r\n                return result == \"\" ? \"NO RESULTS\" : result + \"}\";\r\n            }\r\n            catch (Exception ex)\r\n            {                \r\n\t\t\t\tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                return \"ERROR: \" + message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"18e1cecc-eeb9-4a7a-a092-e46112e35e4d","Name":"Parse MCP Actions data from file - store in JSON","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpactionslist","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"3102ea52-8190-4c3c-8a9c-0853674fa201","Name":"Save MCP Actions list to Special Identifer","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpfilepath\\mcpactions_list.txt","TransferText":"$scriptresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"68bea1e5-8110-45c0-98ab-1fcc7fa246d8","Name":"Save MCP Actions list to file","Type":13,"Enabled":false}],"ID":"5f65c13b-86ed-4bd9-b3a1-8437eba67312","Name":"Refresh Available MCP Actions","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcperrorschat","Value2":"on","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ChatActionModel, MixItUp.Base","ChatText":"Elgato MCP Server Restarting","SendAsStreamer":false,"IsWhisper":false,"WhisperUserName":null,"ID":"73cb0cf3-0cbd-4f9e-a15b-224710ae6a02","Name":"Chat Message","Type":1,"Enabled":true}],"ID":"c63b962c-7cb7-4234-a537-22006032666a","Name":"Message to chat: server restarting","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcprestarted","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"8cce569a-e102-43ef-a0ca-6dc1442db348","Name":"MCP Server Restarted: TRUE","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":1,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcprestartrequested","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$$elgatomcpactionissue","Value2":"true","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[],"ID":"6829b9cf-9511-4823-b710-ee2ba8612048","Name":"If issues or restart request, restart","Type":17,"Enabled":true}],"ID":"5d4eaff0-8466-4817-8305-5f23e4964a91","Name":"Restart MCP server if issue or requested","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcpactionissue","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcprestarted","Value2":"true","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n        {\r\n            string search = \"$allargs\";\r\n            search = search.Trim().ToUpper();\r\n            string[] lines = System.IO.File.ReadAllLines(@\"$elgatomcpmiufolderpath\\mcpactions_list.txt\");\r\n\r\n            foreach (string line in lines)\r\n            {\r\n                int colonIndex = line.IndexOf(\":\");\r\n                if (colonIndex < 0) continue;\r\n\r\n                string key = line.Substring(0, colonIndex).Trim();\r\n                string value = line.Substring(colonIndex + 1).Trim();\r\n\r\n                if (key == search)\r\n                {\r\n                    return value;\r\n                }\r\n            }\r\n\r\n            return \"ERROR: MCP Action \\\"$allargs\\\" not found in list.\";\r\n            \r\n            }\r\n            catch (Exception ex)\r\n\t\t\t{\r\n\t\t\t\tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                return \"ERROR: \" + message;\r\n\t\t\t}\r\n            \r\n        }\r\n    }\r\n}","ID":"e9794da9-85a9-4557-8442-caf5dcf7b0a6","Name":"Get MCP Action ID from file","Type":38,"Enabled":false},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string json = \"$elgatomcpactionslist\";\r\n\r\n                string searchKey = \"$allargs\".Trim().ToUpper();\r\n                string key = \"\\\"\" + searchKey + \"\\\":\\\"\";\r\n                int keyIndex = json.IndexOf(key);\r\n\r\n                if (keyIndex == -1)\r\n                    return \"ERROR: MCP Action \\\"$allargs\\\" not found in list\";\r\n\r\n                int valueStart = keyIndex + key.Length;\r\n                int valueEnd = json.IndexOf('\"', valueStart);\r\n\r\n                if (valueEnd == -1)\r\n                    return \"ERROR: MCP Action list may be corrupt\";\r\n\r\n                return json.Substring(valueStart, valueEnd - valueStart);\r\n            }\r\n            catch\r\n            {\r\n                return \"ERROR: Unexpected error reading MCP Action list from Special Identifier\";\r\n            }\r\n        }\r\n    }\r\n}","ID":"614e3e4e-48f6-40c0-8d1c-43c8ed30bde7","Name":"Get MCP Action ID from Special Identifier","T