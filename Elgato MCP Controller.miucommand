done\",\r\n\t\t\t\t\t    \"\\t\\t)\",\r\n\t\t\t\t\t    \"    )\",\r\n\t\t\t\t\t    \") else (\",\r\n\t\t\t\t\t    \"    echo No process found on port 9090.\",\r\n\t\t\t\t\t    \")\",\r\n\t\t\t\t\t    \":done\",\r\n\t\t\t\t\t    \"exit\"\r\n\t\t\t\t\t});\r\n                    \r\n                    string message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file created: \" + batPath;\r\n                    return null;\r\n                }\r\n                else\r\n                {\r\n                \r\n                \tstring message = batPath.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                    //return \"Bat file already exists: \" + batPath;\r\n                    return null;\r\n                }\r\n            }\r\n            catch (UnauthorizedAccessException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Permission denied: \" + ex.Message;\r\n            }\r\n            catch (DirectoryNotFoundException ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Directory not found: \" + ex.Message;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n            \tstring message = ex.Message.Replace(@\"$elgatomcpmiufolderpath\\\", \"\");\r\n                \r\n                return \"ERROR: Unexpected error: \" + ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"80486437-0c46-4216-b57d-c0fc4abfd97e","Name":"Create server stop batch file, if doesn't exist","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpmiufolderpath\\elgato_mcp_stop.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish"