eZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string headers = @\"$externalprogramresult\";\r\n\r\n                string sessionId = null;\r\n                foreach (string line in headers.Split('\\n'))\r\n                {\r\n                    if (line.StartsWith(\"mcp-session-id:\"))\r\n                    {\r\n                        sessionId = line.Split(':')[1].Trim();\r\n                        break;\r\n                    }\r\n                }\r\n\r\n                return sessionId;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                return ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"eff634c8-025f-492b-891c-e579486ba77e","Name":"Extract MCP Session ID","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpsessionid","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"5283f1fa-f473-4f30-b216-664aab74019b","Name":"Save Session ID to Special Identifier","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpsessioniddatetime","ReplacementText":"$datetime","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"c86d108b-42a7-4c9e-8384-60373f0a8eb4","Name":"Date Time when Session ID Refreshed","Type":12,"Enabled":true}],"ID":"58295eec-036f-42df-a9c6-02a51656dd18","Name":"Get MCP Session ID","Type":39,"Enabled":true}],"ID":"cfe31182-e996-4126-a0e5-4a55cef3a73c","Name":"Conditional","Type":17,"Enabled":false},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n        {\r\n            string search = \"$allargs\";\r\n            search = search.Trim().ToUpper();\r\n            string[] lines = System.IO.File.ReadAllLines(@\"$elgatomcpfilepath\\mcpactions_list.txt\");\r\n\r\n            foreach (string line in lines)\r\n            {\r\n                int colonIndex = line.IndexOf(\":\");\r\n                if (colonIndex < 0) continue;\r\n\r\n                string key = line.Substring(0, colonIndex).Trim();\r\n                string value = line.Substring(colonIndex + 1).Trim();\r\n\r\n                if (key == search)\r\n                {\r\n                    return value;\r\n                }\r\n            }\r\n\r\n            return \"ERROR: MCP Action \\\"$allargs\\\" not found in list.\";\r\n            \r\n            }\r\n            catch (Exception ex)\r\n\t\t\t{\r\n\t\t\t\tstring message = ex.Message.Replace(@\"$elgatomcpfilepath\\\", \"\");\r\n                return \"ERROR: \" + message;\r\n\t\t\t}\r\n            \r\n        }\r\n    }\r\n}","ID":"97972053-4460-40c2-93cb-e8d93ed994a3","Name":"Get MCP Action ID from file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcplistlookupresult1","ReplacementText":"$scriptresult","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"34841a40-897f-4c18-8da9-37203530f3d3","Name":"Store script result","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":6,"Value1":"$elgatomcplistlookupresult1","Value2":"ERROR","Value3":""}],"CommandID":"00000000-0000-0000-0000-00000000000