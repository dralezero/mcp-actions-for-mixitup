auses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":1,"Value1":"$elgatomcphealth","Value2":"{\"status\":\"ok\",\"AppConnected\":true}","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcprestartrequested","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$$elgatomcpactionissue","Value2":"true","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpfilepath\\elgato_mcp_stop.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":false,"ID":"eee0df08-5a87-4722-8eaf-12d765e7d804","Name":"Stop MCP Server","Type":3,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"$elgatomcpfilepath\\elgato_mcp_start.bat","Arguments":null,"ShowWindow":false,"ShellExecute":false,"WaitForFinish":false,"SaveOutput":false,"ID":"6b24fb50-6aeb-4c8a-9d31-740e6dd4922f","Name":"Start MCP Server","Type":3,"Enabled":true}],"ID":"f5476a2f-c8ea-4667-a4b9-f05ff29a18ee","Name":"Restart MCP Server","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"C:\\Windows\\System32\\curl.exe","Arguments":"-s -g -X POST -H \"Accept: application/json, text/event-stream\" -H \"Content-Type: application/json\" -d \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\\"initialize\\\",\\\"params\\\":{\\\"protocolVersion\\\":\\\"2024-11-05\\\",\\\"capabilities\\\":{},\\\"clientInfo\\\":{\\\"name\\\":\\\"test\\\",\\\"version\\\":\\\"1.0\\\"}},\\\"id\\\":1}\" -D - -o nul http://$elgatomcpurl/mcp","ShowWindow":false,"ShellExecute":false,"WaitForFinish":true,"SaveOutput":true,"ID":"f9aefaa3-e1b1-4194-9ca5-08d2a8776826","Name":"Get MCP Server Info","Type":3,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n            try\r\n            {\r\n                string headers = @\"$externalprogramresult\";\r\n\r\n                string sessionId = null;\r\n                foreach (string line in headers.Split('\\n'))\r\n                {\r\n                    if (line.StartsWith(\"mcp-session-id:\"))\r\n                    {\r\n                        sessionId = line.Split(':')[1].Trim();\r\n                        break;\r\n                    }\r\n                }\r\n\r\n                return sessionId;\r\n            }\r\n            catch (Exception ex)\r\n            {\r\n                return ex.Message;\r\n            }\r\n        }\r\n    }\r\n}","ID":"38551259-d119-4007-8013-c6ac177d6d9f","Name":"Extract MCP Session ID","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpsessionid","ReplacementText":"$scriptresult","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"5299e391-a958-4fe3-a51d-8416eb1d160b","Name":"Save Session ID to Special Identifier","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcpsessioniddatetime","ReplacementText":"$datetime","MakeGloballyUsable":true,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"23070596-6a08-4b86-a5ed-41390509ac4f","Name":"Date Time when Session ID Refreshed","Type":12,"Enabled":true}],"ID":"a3862332-bdf4-42a4-941c-549935b2b20b","Name":"Get MCP Session ID","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.GroupActionModel, MixItUp.Base","Actions":[{"$type":"MixItUp.Base.Model.Actions.WebRequestActionModel, MixItUp.Base","Url":"http://$elgatomcpurl/mcp","ResponseType":0,"JSONToSpecialIdentifiers":null,"HttpMethod":1,"CustomHeaders":{"$type":"System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib","Accept":"application/json, text/event-stream","Content-Type":"application/json","mcp-session-id":"$elgatomcpsessionid"},"RequestBody":"{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"streamdeck__get_executable_actions\",\"arguments\":{}},\"id\":3}","ID":"8ba985ab-8682-48ce-9eb6-12960ad58c91","Name":"Get MCP Actions data","Type":11,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpfilepath\\mcpactions_json.txt","TransferText":"$webrequestresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"e1dbdbd8-549e-4ac7-b2b7-cf20626ff6a6","Name":"Save MCP Actions data to file","Type":13,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero using Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n    \t{\r\n            string raw = System.IO.File.ReadAllText(@\"$elgatomcpfilepath\\mcpactions_json.txt\");\r\n            raw = raw.Replace(\"\\\\n\", \"\").Replace(\"\\\\\\\"\", \"\\\"\");\r\n\r\n            string result = \"\";\r\n            int pos = 0;\r\n\r\n            while (pos < raw.Length)\r\n            {\r\n                // Find title first\r\n                int titleIndex = raw.IndexOf(\"\\\"title\\\": \\\"\", pos);\r\n                if (titleIndex < 0) break;\r\n                int titleStart = titleIndex + 10;\r\n                int titleEnd = raw.IndexOf(\"\\\"\", titleStart);\r\n                if (titleEnd < 0) break;\r\n                string title = raw.Substring(titleStart, titleEnd - titleStart);\r\n                title = title.Trim().ToUpper();\r\n\r\n                // Search BACKWARDS before title for the UUID id\r\n                string id = \"\";\r\n                int searchBack = titleIndex;\r\n                while (searchBack > pos)\r\n                {\r\n                    int idIndex = raw.LastIndexOf(\"\\\"id\\\": \\\"\", searchBack);\r\n                    if (idIndex < pos) break;\r\n                    int idStart = idIndex + 7;\r\n                    if (idStart + 36 > raw.Length) break;\r\n                    string candidate = raw.Substring(idStart, 36);\r\n                    if (candidate[8] == '-' && candidate[13] == '-' && candidate[18] == '-' && candidate[23] == '-')\r\n                    {\r\n                        id = candidate;\r\n                        break;\r\n                    }\r\n                    searchBack = idIndex - 1;\r\n                }\r\n\r\n                if (id != \"\")\r\n                    result += title + \":\" + id + \"\\n\";\r\n\r\n                pos = titleEnd;\r\n            }\r\n\r\n            return result == \"\" ? \"NO RESULTS\" : result;\r\n            \r\n            }\r\n   \t\t\t catch (Exception ex)\r\n    \t\t{\r\n      \t\t  return \"ERROR: \" + ex.Message;\r\n    \t\t}\r\n            \r\n            \r\n        }\r\n    }\r\n}","ID":"a14c4283-7e17-44e5-9cc5-5e025bcec702","Name":"Parse MCP Actions data from file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.FileActionModel, MixItUp.Base","ActionType":0,"FilePath":"$elgatomcpfilepath\\mcpactions_list.txt","TransferText":"$scriptresult","LineIndex":null,"CaseSensitive":false,"Actions":[],"ID":"76325816-236e-4b91-8c55-65e609980167","Name":"Save MCP Actions list to file","Type":13,"Enabled":true}],"ID":"5586f885-acbb-45f7-a6ac-be9964a60b40","Name":"Refresh Available MCP Actions","Type":39,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcperrorschat","Value2":"on","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ChatActionModel, MixItUp.Base","ChatText":"Elgato MCP Server Restarting","SendAsStreamer":false,"IsWhisper":false,"WhisperUserName":null,"ID":"73cb0cf3-0cbd-4f9e-a15b-224710ae6a02","Name":"Chat Message","Type":1,"Enabled":true}],"ID":"da98b261-9858-46e4-bfd3-20c21547b53d","Name":"Message to chat: server restarting","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcprestarted","ReplacementText":"true","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"8cce569a-e102-43ef-a0ca-6dc1442db348","Name":"MCP Server Restarted: TRUE","Type":12,"Enabled":true}],"ID":"98105a53-ba5c-452b-95e2-7a35268c6c72","Name":"If issues or restart request, restart","Type":17,"Enabled":true}],"ID":"eddd8e37-fbba-413f-a59f-ea1a49c9a44c","Name":"Restart MCP server if issue or requested","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcpactionissue","Value2":"true","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcprestarted","Value2":"true","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//made by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n        {\r\n            string search = \"$allargs\";\r\n            search = search.Trim().ToUpper();\r\n            string[] lines = System.IO.File.ReadAllLines(@\"$elgatomcpfilepath\\mcpactions_list.txt\");\r\n\r\n            foreach (string line in lines)\r\n            {\r\n                int colonIndex = line.IndexOf(\":\");\r\n                if (colonIndex < 0) continue;\r\n\r\n                string key = line.Substring(0, colonIndex).Trim();\r\n                string value = line.Substring(colonIndex + 1).Trim();\r\n\r\n                if (key == search)\r\n                {\r\n                    return value;\r\n                }\r\n            }\r\n\r\n            return \"ERROR: MCP Action \\\"$allargs\\\" not found in list.\";\r\n            \r\n            }\r\n            catch (Exception ex)\r\n\t\t\t{\r\n\t\t\t\tstring message = ex.Message.Replace(@\"$elgatomcpfilepath\\\", \"\");\r\n                return \"ERROR: \" + message;\r\n\t\t\t}\r\n            \r\n        }\r\n    }\r\n}","ID":"fa6c436d-65d2-49f7-81f8-efe312ac01d5","Name":"Get MCP Action ID from file","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"elgatomcplistlookupresult2","ReplacementText":"$scriptresult","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"c8c1d753-7575-4427-9ef8-3c43fc401c1c","Name":"Store script result","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":6,"Value1":"$elgatomcplistlookupresult2","Value2":"ERROR","Value3":""},{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":0,"Value1":"$elgatomcperrorschat","Value2":"on","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.ChatActionModel, MixItUp.Base","ChatText":"$elgatomcplistlookupresult2","SendAsStreamer":false,"IsWhisper":false,"WhisperUserName":null,"ID":"92275412-5bea-4493-8ad6-ea294a4c3513","Name":"Chat Message","Type":1,"Enabled":true}],"ID":"8b379f97-5fc1-46c6-99c7-1ebb8584da16","Name":"If Action not found, error","Type":17,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ConditionalActionModel, MixItUp.Base","CaseSensitive":false,"Operator":0,"RepeatWhileTrue":false,"Clauses":[{"$type":"MixItUp.Base.Model.Actions.ConditionalClauseModel, MixItUp.Base","ComparisionType":7,"Value1":"$scriptresult","Value2":"ERROR","Value3":""}],"CommandID":"00000000-0000-0000-0000-000000000000","Actions":[{"$type":"MixItUp.Base.Model.Actions.WebRequestActionModel, MixItUp.Base","Url":"http://localhost:9090/mcp","ResponseType":0,"JSONToSpecialIdentifiers":null,"HttpMethod":1,"CustomHeaders":{"$type":"System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib","Content-Type":"application/json","Accept":"application/json, text/event-stream","mcp-session-id":"$elgatomcpsessionid"},"RequestBody":"{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"streamdeck__execute_action\",\"arguments\":{\"id\":\"$scriptresult\"}},\"id\":4}","ID":"7e611d05-dfa4-4d43-8c39-5bcd3849a054","Name":"Web Request IS FAST BUT NO ERROR CATCH","Type":11,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ExternalProgramActionModel, MixItUp.Base","FilePath":"C:\\Windows\\System32\\curl.exe","Arguments":"curl -X POST http://$elgatomcpurl/mcp -H \"Content-Type: application/json\" -H \"Accep