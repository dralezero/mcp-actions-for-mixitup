{"$type":"MixItUp.Base.Model.Commands.ActionGroupCommandModel, MixItUp.Base","RunOneRandomly":false,"ID":"a5d4e1d9-ac6a-4748-b8d6-4a4348543d7d","Name":"Elgato MCP Action Template","Type":4,"IsEnabled":true,"Unlocked":false,"IsEmbedded":false,"GroupName":"Elgato MCP Actions","Triggers":[],"Requirements":{"$type":"MixItUp.Base.Model.Requirements.RequirementsSetModel, MixItUp.Base","Requirements":[]},"Actions":[{"$type":"MixItUp.Base.Model.Actions.SpecialIdentifierActionModel, MixItUp.Base","SpecialIdentifierName":"actiontitle","ReplacementText":"BUTTON_TITLE_HERE","MakeGloballyUsable":false,"ShouldProcessMath":false,"ReplaceSpecialIdentifiersInFunctions":false,"ID":"facc1df8-7097-48a2-a400-303016a97f45","Name":"Special Identifier","Type":12,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.ScriptActionModel, MixItUp.Base","ActionType":0,"Script":"using System;\r\n\r\n//vibecoded by DraleZero with Claude\r\n\r\nnamespace CustomNamespace\r\n{\r\n    public class CustomClass\r\n    {\r\n        public object Run()\r\n        {\r\n        \r\n        try\r\n        {\r\n            string search = \"$actiontitle\";\r\n            search = search.Trim().ToUpper();\r\n            string[] lines = System.IO.File.ReadAllLines(@\"$elgatomcpfilepath\\mcpactions_list.txt\");\r\n\r\n            foreach (string line in lines)\r\n            {\r\n                int colonIndex = line.IndexOf(\":\");\r\n                if (colonIndex < 0) continue;\r\n\r\n                string key = line.Substring(0, colonIndex).Trim();\r\n                string value = line.Substring(colonIndex + 1).Trim();\r\n\r\n                if (key == search)\r\n                {\r\n                    return value;\r\n                }\r\n            }\r\n\r\n            return \"MCP ACTION NOT FOUND IN LIST\";\r\n            \r\n            }\r\n            catch (Exception ex)\r\n\t\t\t{\r\n   \t\t\t return \"ERROR: \" + ex.Message;\r\n\t\t\t}\r\n            \r\n        }\r\n    }\r\n}","ID":"afd6240e-e398-458a-bcd4-048986337952","Name":"Script","Type":38,"Enabled":true},{"$type":"MixItUp.Base.Model.Actions.WebRequestActionModel, MixItUp.Base","Url":"http://localhost:9090/mcp","ResponseType":0,"JSONToSpecialIdentifiers":null,"HttpMethod":1,"CustomHeaders":{"$type":"System.Collections.Generic.Dictionary`2[[System.String, System.Private.CoreLib],[System.String, System.Private.CoreLib]], System.Private.CoreLib","Content-Type":"application/json","Accept":"application/json, text/event-stream","mcp-session-id":"$elgatomcpsessionid"},"RequestBody":"{\"jsonrpc\":\"2.0\",\"method\":\"tools/call\",\"params\":{\"name\":\"streamdeck__execute_action\",\"arguments\":{\"id\":\"$scriptresult\"}},\"id\":4}","ID":"92a1b456-6c93-4f50-8a51-ec9bc8eead97","Name":"Web Request","Type":11,"Enabled":true}]}